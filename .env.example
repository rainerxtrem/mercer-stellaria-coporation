# ---------------------------------------------------------------------------
# Copy to .env for local development. Never commit real values.
# On Railway, set these as service variables instead.
# ---------------------------------------------------------------------------

# --- Database (required) ---------------------------------------------------
# Railway injects this automatically when a PostgreSQL service is attached:
#   DATABASE_URL=${{ Postgres.DATABASE_URL }}
DATABASE_URL=postgres://postgres:postgres@localhost:5432/bar_portal
# "disable" | "require". Leave empty to derive it from sslmode in the URL.
DATABASE_SSL=
DATABASE_POOL_MAX=10
DATABASE_STATEMENT_TIMEOUT_MS=20000

# --- Runtime (required) ----------------------------------------------------
# Railway provides PORT; keep 8080 locally.
PORT=8080
NODE_ENV=development
# Public origin, used to build the links sent by email.
PUBLIC_SITE_URL=http://localhost:8080
SITE_NAME=Mercer & Stellaria Corporation

# --- Authentication (required) ---------------------------------------------
# Signing key for access tokens and signed storage URLs. Minimum 32 characters.
# Generate one with: openssl rand -base64 48
AUTH_JWT_SECRET=
AUTH_ACCESS_TOKEN_TTL=3600
AUTH_REFRESH_TOKEN_TTL=2592000
AUTH_MIN_PASSWORD_LENGTH=8
AUTH_BCRYPT_ROUNDS=10
AUTH_REQUIRE_EMAIL_CONFIRMATION=false

# --- File storage (required in production) ---------------------------------
# Mount a Railway volume here so uploaded documents survive redeploys.
STORAGE_ROOT=/data/storage
STORAGE_MAX_UPLOAD_BYTES=26214400

# --- Transactional email (optional) ----------------------------------------
# Without SMTP_HOST, invitation and password-reset links are written to the
# application logs instead of being sent.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=no-reply@example.com

# --- Document analysis AI (optional) ---------------------------------------
# Any OpenAI-compatible chat-completions endpoint. Without a key the template
# analyser falls back to its built-in heuristic detection.
AI_API_BASE_URL=https://api.openai.com/v1
AI_API_KEY=
AI_MODEL=gpt-4o-mini

# --- Operations ------------------------------------------------------------
# Set to "false" to skip automatic migrations at container start.
RUN_MIGRATIONS_ON_BOOT=true

# --- Discord OAuth (client portal auth) -----------------------------------
# Railway production URL (without trailing slash), e.g.
# APP_BASE_URL=https://mercer-stellaria-corporation.up.railway.app
APP_BASE_URL=http://localhost:8080
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
# Leave empty to use APP_BASE_URL/api/auth/discord/callback
DISCORD_REDIRECT_URI=
# Keep `guilds` if you enforce server membership checks in callback.
DISCORD_OAUTH_SCOPES=identify email guilds
# Optional. If set, callback verifies the Discord user is a member of this guild.
DISCORD_GUILD_ID=
# Optional but recommended for role synchronization at login.
# Required to read guild member role names and map them to site permissions.
DISCORD_BOT_TOKEN=

# --- Accounting webhooks (optional) ---------------------------------------
# If set, incoming accounting webhooks must include this token via
# `x-accounting-token` header or `?token=` query parameter.
ACCOUNTING_WEBHOOK_TOKEN=
